# ─── Clinic Chatbot - Environment Variables ───

# LLM Provider: "auto" (default), "ollama", or "gemini"
# auto = tries Ollama first, falls back to Gemini
LLM_PROVIDER=auto

# ─── Gemini (Cloud API) ───
GEMINI_API_KEY=your-gemini-api-key-here

# ─── Ollama (Local LLM) ───
OLLAMA_MODEL=llama3
OLLAMA_URL=http://localhost:11434
